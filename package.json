{
  "name": "syncopatejs",
  "version": "0.7.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "tools/hoist-skill/test && tools/sync/test && node scripts/compute-bump.test.ts && bash scripts/test-sync.sh && bash scripts/test-bootstrap.sh && node scripts/check-resolvable.ts --strict && node scripts/update-skills-doc.ts --check",
    "test:integration": "RUN_INTEGRATION=1 tools/hoist-skill/test-integration && RUN_INTEGRATION=1 tools/sync/test-integration",
    "test:experiments": "node --test 'experiments/**/*.test.mjs'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix && tsc --noEmit"
  },
  "bin": {
    "scaffold": "./bin/sync"
  },
  "devDependencies": {
    "eslint": "^10.5.0",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.61.1",
    "globals": "^17.6.0"
  }
}
